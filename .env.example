# Токен бота от @BotFather. Обязателен: без него бот не запустится.
TELEGRAM_BOT_TOKEN=123456789:AAH-пример-токена-от-BotFather

# Необязательно: прокси для Telegram, если провайдер блокирует api.telegram.org.
# Формат: http://user:pass@host:port или socks5://host:port
# TELEGRAM_PROXY=http://127.0.0.1:1080

# Необязательно: пускать к боту только этих людей (Telegram ID через запятую).
# Свой ID бот показывает в «📊 Статистика». Пусто (по умолчанию) — бот открыт для всех.
# ALLOWED_USERS=123456789,987654321

# Необязательно: сколько дней хранить скачанные ролики и недоделанные выдачи (по умолчанию 3, 0 — не чистить).
# CLEANUP_DAYS=3

# Предохранители общего сервера (во всех случаях 0 — не ограничивать):
# сколько задач бот держит одновременно, идущая и ждущие (по умолчанию 6) — остальным он говорит «очередь заполнена»
# MAX_QUEUE=6
# сколько гигабайт на диске должно оставаться, чтобы принять новую задачу (по умолчанию 5)
# MIN_FREE_GB=5
# потолок кеша скачанных роликов в гигабайтах: сверху убираются самые старые записи (по умолчанию 12)
# CACHE_LIMIT_GB=12
